# Database
DATABASE_URL=postgresql://menstrual_user:menstrual_pass@postgres:5432/menstrual_db

# JWT
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis
REDIS_URL=redis://redis:6379/0

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# ML
MODEL_DIR=/app/ml_models

# Email (SMTP) — optional, for health alert emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=MenstrualAI Health

# CORS
CORS_ORIGINS=http://localhost:9000,http://localhost:5173
